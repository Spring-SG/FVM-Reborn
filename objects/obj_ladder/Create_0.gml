host_search_timer = 0      // 反查宿主计时（太久找不到说明是无效梯子，自毁）
spawn_row = -1             // 放梯子那只老鼠所在的行（放置者填；-1 = 没给 → 退回按梯子自身坐标反查）
spawn_col = -1             // 同上，列
