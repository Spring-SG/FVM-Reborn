function cookbook_registry_init(){
	global.cookbook_pool = ds_map_create()
	global.cookbook_list = []
}

function register_cookbook(cookbook_id,cookbook_data){
	ds_map_add(global.cookbook_pool,cookbook_id,cookbook_data)
	array_push(global.cookbook_list,cookbook_id)
}

function get_cookbook_data(cookbook_id){
	return ds_map_find_value(global.cookbook_pool,cookbook_id)
}

function is_cookbook_equipped(cookbook_id){
	var cd = get_cookbook_data(cookbook_id)
	var cl = global.save_data.equipped_cookbook[cd.rank]
	if array_get_index(cl,cookbook_id) != -1{
		return true
	}
	return false
}

function equip_cookbook(cookbook_id){
	if !is_cookbook_equipped(cookbook_id){
		var cd = get_cookbook_data(cookbook_id)
		array_push(global.save_data.equipped_cookbook[cd.rank],cookbook_id)
	}
}

function unequip_cookbook(cookbook_id){
	if is_cookbook_equipped(cookbook_id){
		var cd = get_cookbook_data(cookbook_id)
		array_delete(global.save_data.equipped_cookbook[cd.rank],array_get_index(global.save_data.equipped_cookbook[cd.rank],cookbook_id),1)
	}
}

